{
    "name": "mohammed-asheek/dev-toolkit",
    "description": "Interactive CLI for local development tools",
    "type": "library",
    "homepage": "https://github.com/asheek21-baaboo/dev-toolkit",
    "support": {
        "issues": "https://github.com/asheek21-baaboo/dev-toolkit/issues",
        "source": "https://github.com/asheek21-baaboo/dev-toolkit"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\DevToolkit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MyVendor\\DevToolkit\\ToolkitServiceProvider"
            ]
        }
    }
}